PORT=5000
MONGODB_URI=mongodb://localhost:27017/gold-silver-saas
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
NODE_ENV=development
# default global window (hours) for reversing stock/cash when vouchers/settlements are deleted
# individual users may override via Account settings
REVERSAL_WINDOW_HOURS=48

# Optional: Set custom frontend URL for production deployments
# FRONTEND_URL=https://your-frontend-domain.com

# Used once by `npm run seed` to create the admin account (password: 8+ characters)
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_SHOP_NAME=Admin
